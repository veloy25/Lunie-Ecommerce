# Copy this file to .env for local development. Never commit real credentials.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://lunie:lunie-local-only@db:5432/lunie
POSTGRES_PASSWORD=lunie-local-only
SESSION_SECRET=replace-with-a-random-secret-for-local-development
PII_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
ADMIN_EMAILS=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
MELHORENVIO_TOKEN=
MELHORENVIO_WEBHOOK_SECRET=
MELHORENVIO_FROM_POSTAL_CODE=
MELHORENVIO_SENDER_JSON=
MELHORENVIO_INVOICE_KEY=
MELHORENVIO_SANDBOX=true
MELHORENVIO_USER_AGENT=Luniê (suporte técnico a configurar)
SHIPPING_SIMULATION=false
CATALOG_PATH=catalog/products.json
